{
  "name": "@grainshape/stet-svelte",
  "type": "module",
  "version": "0.0.0",
  "description": "Stet for Svelte 5: render a Stet document with your own components and edit it in place",
  "author": "John van Dijk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grainshape/stet.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/grainshape/stet/tree/main/packages/svelte#readme",
  "bugs": "https://github.com/grainshape/stet/issues",
  "keywords": [
    "svelte",
    "editor",
    "yjs",
    "structured-content",
    "contenteditable"
  ],
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "prebuild": "pnpm run clean",
    "dev": "svelte-package -i src -o dist --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@grainshape/stet": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.59.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yjs": "^13.6.33"
  }
}
